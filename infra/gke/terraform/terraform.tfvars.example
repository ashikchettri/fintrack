# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# A DEDICATED FinTrack project — never a shared or production project for
# something else. Create one:  gcloud projects create fintrack-<suffix>
project_id  = "fintrack-REPLACE-ME"

region      = "australia-southeast1"
github_repo = "ashikchettri/fintrack"

# Billing account for the monthly budget alert (gcloud billing accounts list).
billing_account = "0X0000-0X0000-0X0000"
# monthly_budget = 50   # USD; alerts at 50/90/100% (default 50)
